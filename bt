#!/usr/bin/env bash
# browser-transport: run a dedicated Firefox through gluetun (WireGuard) via a loopback HTTP proxy.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WG_CONF="$ROOT/wg0.conf"
PROFILE="$ROOT/profile"
PROXY="http://127.0.0.1:8888"
CHECK_URL="https://api.ipify.org"

if [[ -z "${FIREFOX:-}" ]]; then
  for c in "/Applications/Firefox Developer Edition.app/Contents/MacOS/firefox" \
           "/Applications/Firefox.app/Contents/MacOS/firefox" \
           firefox-developer-edition firefox; do
    if [[ -x "$c" ]] || command -v "$c" >/dev/null 2>&1; then FIREFOX="$c"; break; fi
  done
fi

die() { echo "error: $*" >&2; exit 1; }
# First IPv4 address from the config's `DNS =` line (gluetun ignores that line itself).
wg_dns() {
  [[ -f "$WG_CONF" ]] || return 0
  sed -nE 's/^[[:space:]]*DNS[[:space:]]*=[[:space:]]*//p' "$WG_CONF" | tr ',' '\n' | tr -d ' \t\r' |
    grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | head -1 || true
}
compose() { WG_DNS="${WG_DNS:-127.0.0.1}" docker compose --project-directory "$ROOT" -f "$ROOT/compose.yaml" "$@"; }

check_conf() {
  # Must exist before `compose up`, or Docker creates a directory at the mount path.
  [[ -f "$WG_CONF" ]] || die "missing $WG_CONF (paste your WireGuard config there)"
  grep -q '^\[Interface\]' "$WG_CONF" || die "$WG_CONF doesn't look like a WireGuard config"
  local mode
  if [[ "$(uname)" == Darwin ]]; then mode="$(stat -f '%Lp' "$WG_CONF")"; else mode="$(stat -c '%a' "$WG_CONF")"; fi
  if [[ "$mode" != "600" ]]; then
    chmod 600 "$WG_CONF" && echo "fixed: chmod 600 wg0.conf (contains your private key)"
  fi
  WG_DNS="$(wg_dns)"
  [[ -n "$WG_DNS" ]] || die "no IPv4 DNS server in $WG_CONF (expected e.g. 'DNS = 10.2.0.1')"
  export WG_DNS
  if git -C "$ROOT" ls-files --error-unmatch wg0.conf >/dev/null 2>&1; then
    die "wg0.conf is tracked by git; remove it (git rm --cached wg0.conf) and rotate the key"
  fi
}

up() {
  check_conf
  compose up -d --wait --wait-timeout 90 || { compose logs --tail 40; die "gluetun failed to become healthy"; }
}

verify() {
  local direct vpn
  vpn="$(curl -fsS --max-time 15 --proxy "$PROXY" "$CHECK_URL")" || die "no connectivity through proxy"
  direct="$(curl -fsS --max-time 10 "$CHECK_URL" || true)"
  [[ -n "$vpn" && "$vpn" != "$direct" ]] || die "proxy egress IP ($vpn) matches direct IP; refusing"
  echo "ok: egress IP $vpn (direct: ${direct:-unknown})"
}

# PIDs of the Firefox instance(s) running our profile (by command line, so it
# survives Firefox restarting itself; content child processes are skipped).
browser_pids() {
  local pid cmd
  while read -r pid cmd; do
    [[ "$cmd" == *"-contentproc"* ]] && continue
    case "$cmd " in *" -profile $PROFILE "*) echo "$pid" ;; esac
  done < <(ps -axo pid=,command=)
}

launch() {
  [[ -n "${FIREFOX:-}" ]] || die "Firefox not found; set FIREFOX=/path/to/firefox"
  if [[ -n "$(browser_pids)" ]]; then echo "browser already running"; return; fi
  mkdir -p "$PROFILE" && chmod 700 "$PROFILE"
  cp "$ROOT/firefox/user.js" "$PROFILE/user.js"
  # -no-remote: separate instance, never hands the URL to your normal (unproxied) Firefox.
  nohup "$FIREFOX" -profile "$PROFILE" -no-remote "$@" >/dev/null 2>&1 &
  disown
  echo "browser launched"
}

stop_browser() {
  local pids i
  pids="$(browser_pids)"
  [[ -n "$pids" ]] || return 0
  kill -TERM $pids 2>/dev/null || true
  for i in {1..20}; do
    [[ -z "$(browser_pids)" ]] && { echo "browser stopped"; return; }
    sleep 0.5
  done
  pids="$(browser_pids)"
  [[ -n "$pids" ]] && kill -KILL $pids 2>/dev/null || true
  echo "browser killed"
}

status() {
  local pids
  pids="$(browser_pids)"
  if [[ -n "$pids" ]]; then echo "browser: running (pid $(echo $pids))"; else echo "browser: stopped"; fi
  compose ps
}

case "${1:-start}" in
  start)  shift || true; up; verify; launch "$@" ;;
  up)     up; verify ;;
  check)  verify ;;
  down)   stop_browser; compose down ;;  # browser first, so it never outlives the tunnel
  stop)   stop_browser ;;
  status) status ;;
  logs)   compose logs -f ;;
  *) echo "usage: $(basename "$0") [start [urls...]|up|check|stop|down|status|logs]" >&2; exit 2 ;;
esac
